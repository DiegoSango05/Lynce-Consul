<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_Process_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:collaboration id="Collab_Process_ToBe">
    <bpmn:participant id="Pool_Process_ToBe" name="Servyeco · Order-to-cash (TO-BE)" processRef="Process_ToBe" />
    <bpmn:textAnnotation id="Annot_1"><bpmn:text>M9 · Cuadro de mando en tiempo real de pedidos, stock, facturación y cobros</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annot_2"><bpmn:text>M10 · Circuito único con responsables y plazos internos por paso</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" name="Servyeco · Order-to-cash (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_ToBe">
      <bpmn:lane id="Lane_1" name="Cliente"><bpmn:flowNodeRef>Start_Necesidad</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Pedido</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_2" name="Administración"><bpmn:flowNodeRef>T_Aviso</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Replan</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_3" name="ERP"><bpmn:flowNodeRef>T_Registra</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Stock</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Lote</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Factura</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Vencimientos</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_4" name="Almacén"><bpmn:flowNodeRef>T_Expide</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_5" name="Laboratorio"><bpmn:flowNodeRef>T_Lote</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_6" name="Contabilidad"><bpmn:flowNodeRef>T_Concilia</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cobrado</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_7" name="Dirección"></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Necesidad" name="Necesidad de producto"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T_Pedido" name="Envía pedido por canal único"><bpmn:documentation>M1: formulario/plantilla de pedido estándar.</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T_Registra" name="Registra y valida el pedido (una sola vez)"><bpmn:documentation>M2: el pedido se introduce una sola vez.</bpmn:documentation><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Stock" name="Consulta stock y lotes en tiempo real"><bpmn:documentation>M3: inventario de lotes en tiempo real.</bpmn:documentation><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Lote" name="¿Lote liberado disponible?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_Aviso" name="Aviso automático al cliente y replanifica"><bpmn:documentation>M5: notificación automática.</bpmn:documentation><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_Replan" name="Pedido replanificado"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="T_Lote" name="Confirma lote preasignado y certificado"><bpmn:documentation>M4: lotes liberados preasignados. M8: trazabilidad cliente–pedido–lote.</bpmn:documentation><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T_Expide" name="Prepara y expide con albarán digital"><bpmn:documentation>M5: albarán digital y aviso automático.</bpmn:documentation><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T_Factura" name="Genera la factura desde el albarán"><bpmn:documentation>M6: facturación automática.</bpmn:documentation><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Vencimientos" name="Controla vencimientos y envía recordatorios"><bpmn:documentation>M7: recordatorios automáticos.</bpmn:documentation><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Concilia" name="Concilia el cobro (automático)"><bpmn:documentation>M7: conciliación bancaria automática.</bpmn:documentation><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_Cobrado" name="Pago conciliado"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Necesidad" targetRef="T_Pedido" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T_Pedido" targetRef="T_Registra" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_Registra" targetRef="T_Stock" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T_Stock" targetRef="GW_Lote" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="GW_Lote" targetRef="T_Aviso" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T_Aviso" targetRef="End_Replan" />
    <bpmn:sequenceFlow id="Flow_7" name="Sí" sourceRef="GW_Lote" targetRef="T_Lote" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T_Lote" targetRef="T_Expide" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T_Expide" targetRef="T_Factura" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T_Factura" targetRef="T_Vencimientos" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T_Vencimientos" targetRef="T_Concilia" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="T_Concilia" targetRef="End_Cobrado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_ToBe">
    <bpmndi:BPMNPlane id="Plane_Process_ToBe" bpmnElement="Collab_Process_ToBe">
      <bpmndi:BPMNShape id="Pool_Process_ToBe_di" bpmnElement="Pool_Process_ToBe" isHorizontal="true"><dc:Bounds x="150" y="80" width="1510" height="840" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="180" y="80" width="1480" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="180" y="200" width="1480" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="180" y="320" width="1480" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true"><dc:Bounds x="180" y="440" width="1480" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_5_di" bpmnElement="Lane_5" isHorizontal="true"><dc:Bounds x="180" y="560" width="1480" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_6_di" bpmnElement="Lane_6" isHorizontal="true"><dc:Bounds x="180" y="680" width="1480" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_7_di" bpmnElement="Lane_7" isHorizontal="true"><dc:Bounds x="180" y="800" width="1480" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Necesidad_di" bpmnElement="Start_Necesidad"><dc:Bounds x="257" y="122" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="235" y="162" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Pedido_di" bpmnElement="T_Pedido"><dc:Bounds x="355" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Registra_di" bpmnElement="T_Registra" bioc:stroke="#2A8A88" bioc:fill="#D9F1F0" color:background-color="#D9F1F0" color:border-color="#2A8A88"><dc:Bounds x="485" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Stock_di" bpmnElement="T_Stock" bioc:stroke="#2A8A88" bioc:fill="#D9F1F0" color:background-color="#D9F1F0" color:border-color="#2A8A88"><dc:Bounds x="615" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Lote_di" bpmnElement="GW_Lote" isMarkerVisible="true" bioc:stroke="#B7700F" bioc:fill="#FCEBD0" color:background-color="#FCEBD0" color:border-color="#B7700F"><dc:Bounds x="770" y="355" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="684" y="401" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Aviso_di" bpmnElement="T_Aviso" bioc:stroke="#2A8A88" bioc:fill="#D9F1F0" color:background-color="#D9F1F0" color:border-color="#2A8A88"><dc:Bounds x="745" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Replan_di" bpmnElement="End_Replan"><dc:Bounds x="907" y="242" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="885" y="282" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Lote_di" bpmnElement="T_Lote"><dc:Bounds x="875" y="580" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Expide_di" bpmnElement="T_Expide"><dc:Bounds x="1005" y="460" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Factura_di" bpmnElement="T_Factura" bioc:stroke="#2A8A88" bioc:fill="#D9F1F0" color:background-color="#D9F1F0" color:border-color="#2A8A88"><dc:Bounds x="1135" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Vencimientos_di" bpmnElement="T_Vencimientos" bioc:stroke="#2A8A88" bioc:fill="#D9F1F0" color:background-color="#D9F1F0" color:border-color="#2A8A88"><dc:Bounds x="1265" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Concilia_di" bpmnElement="T_Concilia" bioc:stroke="#2A8A88" bioc:fill="#D9F1F0" color:background-color="#D9F1F0" color:border-color="#2A8A88"><dc:Bounds x="1395" y="700" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cobrado_di" bpmnElement="End_Cobrado"><dc:Bounds x="1557" y="722" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1535" y="762" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="293" y="140" /><di:waypoint x="355" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="455" y="140" /><di:waypoint x="470" y="140" /><di:waypoint x="470" y="380" /><di:waypoint x="485" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="585" y="380" /><di:waypoint x="615" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="715" y="380" /><di:waypoint x="770" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="795" y="355" /><di:waypoint x="795" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="801" y="333" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="845" y="260" /><di:waypoint x="907" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="820" y="380" /><di:waypoint x="847" y="380" /><di:waypoint x="847" y="620" /><di:waypoint x="875" y="620" /><bpmndi:BPMNLabel><dc:Bounds x="824" y="360" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="975" y="620" /><di:waypoint x="990" y="620" /><di:waypoint x="990" y="500" /><di:waypoint x="1005" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1105" y="500" /><di:waypoint x="1120" y="500" /><di:waypoint x="1120" y="380" /><di:waypoint x="1135" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1235" y="380" /><di:waypoint x="1265" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1365" y="380" /><di:waypoint x="1380" y="380" /><di:waypoint x="1380" y="740" /><di:waypoint x="1395" y="740" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1495" y="740" /><di:waypoint x="1557" y="740" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Annot_1_di" bpmnElement="Annot_1"><dc:Bounds x="705" y="835" width="180" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annot_2_di" bpmnElement="Annot_2"><dc:Bounds x="1095" y="835" width="180" height="50" /></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
